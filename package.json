{
  "name": "ts-backend",
  "version": "1.0.0",
  "description": "TypeScript Express backend",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",

    "infra:start": "cd infra && docker compose --env-file ../.env up -d",
    "infra:stop": "cd infra && docker compose --env-file ../.env down",
    "infra:logs": "cd infra && docker compose --env-file ../.env logs -f",
    "infra:build": "cd infra && docker compose --env-file ../.env up -d --build",

    "db:generate": "npx drizzle-kit generate --config=./src/db/drizzle.config.ts",
    "db:migrate": "npx drizzle-kit migrate --config=./src/db/drizzle.config.ts",
    "db:push": "npx drizzle-kit push --config=./src/db/drizzle.config.ts",
    "db:studio": "npx drizzle-kit studio --config=./src/db/drizzle.config.ts",

    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^1.0.0-rc.4",
    "express": "^4.21.0",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^1.0.0-rc.5-ab785fc",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
